# Host account that owns ./data (ubuntu on the target machine)
PUID=1000
PGID=1000
TZ=Asia/Ho_Chi_Minh

# Download/update behavior. DepotDownloader downloads the Windows build directly;
# SteamCMD is intentionally not included.
UPDATE_ON_START=true
VALIDATE_ON_UPDATE=false
DEPOT_MAX_DOWNLOADS=8

# Server identity. First boot writes editable files below
# data/server/SCUM/Saved/Config/WindowsServer/.
SERVER_NAME=SCUM Docker Server
SERVER_DESCRIPTION=SCUM dedicated server running with Wine stable
SERVER_PASSWORD=
MAX_PLAYERS=32
SERVER_PLAYSTYLE=PVP

# SCUM needs GAME_PORT, GAME_PORT+1, GAME_PORT+2, and a query port.
# Keep query port outside 27020-27050.
GAME_PORT=7777
GAME_PORT_PLUS_1=7778
GAME_PORT_PLUS_2=7779
QUERY_PORT=27015
# Required when running the container in host networking mode.
MULTIHOME_IP=
# RCON uses the game port by default. Put a unique secret only in .env.
RCON_ENABLED=1
RCON_PORT=7777
RCON_PASSWORD=

# BattleEye cannot operate normally in this Wine/container arrangement.
# Remove -nobattleye only after separately validating your BattleEye deployment.
ADDITIONAL_FLAGS=-nobattleye

# Optional Discord-compatible webhook for lifecycle messages. Leave blank to disable.
LOG_WEBHOOK_URL=
